# ============================================================================
# Robot Rumble — Pi control loop configuration.
# Copy to .env and fill in the blanks. Never commit .env (it is gitignored);
# this .env.example is the safe template with no secrets.
# ============================================================================

# --- Identity ---------------------------------------------------------------
# Which robot this Pi is. Used everywhere (telemetry, Cases, command routing).
ROBOT_ID=EDI                 # EDI (Edinburgh) or LON (London)
ROBOT_NAME=Edinburgh         # Friendly display name

# --- Robot hardware ---------------------------------------------------------
# "fake"   = representative simulator (default, no robot needed)
# "sphero" = real RVR+ over UART (Pi only; needs the Sphero SDK installed)
ROBOT_HARDWARE=fake

# --- Run length -------------------------------------------------------------
# Positive = stop after N ticks (100 is ~5s, a quick smoke test).
# 0 = run until Ctrl+C (what you want to watch the robot drive).
MAX_ITERATIONS=0

# --- Salesforce (Service Cloud REST: Cases + command subscriber) ------------
# Required for live Cases and for resume/issue/camera Slack commands to reach
# this Pi. Leave blank to run fully offline (FakeRobot only, no org calls).
SF_MY_DOMAIN=                # My Domain prefix, e.g. trailsignup-xxxx (no .my.salesforce.com)
SF_CLIENT_ID=                # client-credentials External Client App consumer key
SF_CLIENT_SECRET=            # ...consumer secret
SF_API_VERSION=v67.0         # optional; code has a default

# Listen for Robot_Command__e (resume / issue / camera verbs). On by default
# once SF auth is configured. Set false to disable the subscriber.
COMMAND_SUBSCRIBER_ENABLED=true

# --- Data Cloud telemetry (feeds the live dashboard) ------------------------
# "batch" = Ingestion API (~3 min latency) -- the default
# "s2s"   = Server-to-Server real-time (sub-second) -- needs the S2S_* block below
# "both"  = send to both
# Anything else warns and falls back to "batch".
DATACLOUD_MODE=batch
DATACLOUD_SOURCE_NAME=            # Ingestion API connector source name (batch/both)
DATACLOUD_OBJECT_NAME=            # ...object name
DATACLOUD_SEND_INTERVAL_MS=100    # min gap between telemetry sends (100 = up to 10/s)

# --- S2S real-time (only when DATACLOUD_MODE=s2s or both) -------------------
# JWT-bearer auth. The private key lives OUTSIDE the repo at the path below
# (gitignored). Copy the key to the Pi separately; never put key contents here.
S2S_CLIENT_ID=                   # S2S Connected/External App consumer key
S2S_USERNAME=                    # integration user the JWT is issued for
S2S_PRIVATE_KEY_PATH=~/.robot-rumble/s2s/private.key
S2S_APP_SOURCE_ID=               # the S2S ingestion source id

# --- Camera (Pi Camera 3 -> Heroku camera host -> dashboard) ----------------
# Pi-only feature, off by default. Needs CAMERA_UPLOAD_URL + CAMERA_UPLOAD_TOKEN.
CAMERA_ENABLED=false
# Capture + upload a static test frame instead of a real camera (Mac/dev testing).
CAMERA_FAKE=false
# Seconds between captures.
CAMERA_INTERVAL_S=3
# Capture resolution, WIDTHxHEIGHT.
CAMERA_RESOLUTION=640x480
# Camera host base URL (the Heroku app), no trailing slash.
CAMERA_UPLOAD_URL=https://robot-rumble-camera-host.herokuapp.com
# Shared secret; must match the host's CAMERA_UPLOAD_TOKEN. Keep out of git.
CAMERA_UPLOAD_TOKEN=change-me-to-match-the-host
