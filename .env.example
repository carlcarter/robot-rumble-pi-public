# Salesforce OAuth 2.0 (External Client App)
SF_MY_DOMAIN=mycompany
SF_CLIENT_ID=your_client_id_here
SF_CLIENT_SECRET=your_client_secret_here
SF_API_VERSION=v67.0

# Data Cloud Ingestion API (optional)
# The ingest host is NOT set here — it's returned dynamically by the Data Cloud
# token exchange (instance_url) and can rotate. Only the connector/object names are fixed.
DATACLOUD_SOURCE_NAME=CONNECTOR_NAME
DATACLOUD_OBJECT_NAME=OBJECT_NAME
# Minimum gap between telemetry sends to Data Cloud, in ms (100 = up to 10/sec).
DATACLOUD_SEND_INTERVAL_MS=100

# Which Data Cloud transport to use:
#   batch = Ingestion API (~3 min latency; the default)
#   s2s   = Server-to-Server events (real-time, sub-second)
#   both  = send to both, for side-by-side testing
DATACLOUD_MODE=batch

# Data Cloud Server-to-Server (only needed when DATACLOUD_MODE is s2s or both).
# Uses its own External Client App with the JWT Bearer flow (no client secret).
# See S2S_SETUP.md for the setup steps.
S2S_CLIENT_ID=your_s2s_consumer_key_here
# Salesforce username the JWT is issued for (must be allowed to use the app).
S2S_USERNAME=your_s2s_username_here
# PKCS#8 private key. Keep it OUTSIDE the repo; never commit it.
S2S_PRIVATE_KEY_PATH=~/.robot-rumble/s2s/private.key
# Source ID shown on the Server-to-Server connection in Data Cloud Setup.
S2S_APP_SOURCE_ID=your_s2s_source_id_here

# Robot identity
ROBOT_ID=EDI
ROBOT_NAME=Edinburgh
